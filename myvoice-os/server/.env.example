# Set strong, DIFFERENT passwords/keys. Do not commit your actual .env.
ADMIN_PASSWORD=replace-with-strong-admin-password
ENROLLMENT_KEY=replace-with-long-random-enrollment-key
DATABASE_PATH=./myvoice.db

# Speech-to-Text Providers
# Options: openai, faster-whisper, mock
ASR_PROVIDER=openai
OPENAI_API_KEY=

# LLM Providers
# Options: openai, gemini, ollama, openai-compatible, mock
LLM_PROVIDER=openai
AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Text-to-Speech Providers
# Options: edge-tts (free, neural, Bangla + English supported), openai, piper, mock
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-AriaNeural
# For Bangla, use bn-BD-NabanitaNeural or bn-BD-PradeepNeural

# Optional tools
BRAVE_SEARCH_API_KEY=

