#pragma once
// Backend LAN IP, NOT localhost (localhost on ESP32 means ESP32 itself).
// The server PC and ESP32 must be connected to the same LAN.
#define API_BASE_URL "http://192.168.1.100:8000"
// Exactly match server/.env ENROLLMENT_KEY (>=24 chars).
#define ENROLLMENT_KEY "replace-with-long-random-enrollment-key"
// Set a PRIVATE 8+ character password for the temporary Wi-Fi provisioning AP.
#define PROVISIONING_AP_PASSWORD "CHANGE_ME_1234"
#define DEVICE_FW_VERSION "0.1.0"
// Set this only for standalone serial clock in YOUR timezone (Bangladesh +6h).
#define GMT_OFFSET_SEC (6 * 3600)
